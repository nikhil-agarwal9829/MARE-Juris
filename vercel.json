{
  "env": {
    "PYTHONPATH": "backend"
  },
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/backend/app/main.py"
    },
    {
      "source": "/((?!backend/).*)",
      "destination": "/frontend/$1"
    }
  ]
}
