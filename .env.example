# ==================================================
# MARE-Juris Environment Variables Configuration
# ==================================================

# --------------------------------------------------
# Frontend & Client Supabase Credentials (Public)
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --------------------------------------------------
# Server-Side Privileged Supabase Credentials (NEVER expose to frontend!)
# --------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Direct Database / Connection Pooler URL (PostgreSQL)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# --------------------------------------------------
# Mailjet Transactional Email & SMTP Configuration
# --------------------------------------------------
MAILJET_API_KEY=your-mailjet-api-key-here
MAILJET_SECRET_KEY=your-mailjet-secret-key-here
MAILJET_SMTP_HOST=in-v3.mailjet.com
MAILJET_SMTP_PORT=587
MAILJET_FROM_EMAIL=your-verified-email@domain.com
MAILJET_FROM_NAME=MARE-Juris Legal

# --------------------------------------------------
# Resend Transactional Email Configuration (Optional)
# --------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=MARE-Juris Legal

# --------------------------------------------------
# LLM Provider Configuration
# --------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
